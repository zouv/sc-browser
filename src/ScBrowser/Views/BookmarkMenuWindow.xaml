<Window x:Class="ScBrowser.Views.BookmarkMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="书签"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <!-- 独立顶层窗口（airspace）：Chrome 星标菜单同款——名称 + 文件夹 + 完成/移除 -->
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="16,14,16,12">
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" />

            <TextBlock Text="名称" Margin="0,12,0,4" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="NameBox"
                     FontSize="13"
                     Padding="8,6"
                     Background="{DynamicResource AddressBarBackgroundBrush}"
                     BorderBrush="{DynamicResource SeparatorBrush}" />

            <TextBlock x:Name="UrlLabel" Text="网址" Margin="0,10,0,4" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
            <TextBox x:Name="UrlBox"
                     FontSize="13"
                     Padding="8,6"
                     Background="{DynamicResource AddressBarBackgroundBrush}"
                     BorderBrush="{DynamicResource SeparatorBrush}"
                     Visibility="Collapsed" />

            <TextBlock Text="文件夹" Margin="0,10,0,4" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox x:Name="FolderBox"
                      FontSize="13"
                      Padding="6,4"
                      Background="{DynamicResource AddressBarBackgroundBrush}"
                      BorderBrush="{DynamicResource SeparatorBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="RemoveButton"
                        Style="{StaticResource DialogButtonStyle}"
                        Content="移除"
                        Visibility="Collapsed"
                        Click="Remove_Click" />
                <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                        Content="完成"
                        IsDefault="True"
                        Margin="8,0,0,0"
                        Click="Done_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
