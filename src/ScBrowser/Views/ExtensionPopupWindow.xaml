<Window x:Class="ScBrowser.Views.ExtensionPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扩展"
        Width="400"
        Height="560"
        MinWidth="240"
        MinHeight="120"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Deactivated="Window_Deactivated">

    <!-- 独立顶层窗口：扩展弹窗必须能盖在网页上，而 WebView2 是子 HWND（airspace） -->
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <Grid x:Name="Root" ClipToBounds="True" />
    </Border>
</Window>
