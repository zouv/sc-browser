<Window x:Class="ScBrowser.Views.LinkStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="链接地址"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">

    <!-- 链接悬停地址气泡：独立顶层窗口。
         WebView2 是独立子 HWND，WPF 元素盖不到网页上（airspace），所以不能放进主窗口布局；
         窗口在 NativeMethods.MakeClickThrough 里设为点击穿透 + 不激活 + 工具窗口，
         因此它既不会挡住网页链接，也不会抢走键盘焦点或在 Alt+Tab 里出现。 -->
    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,3">
        <TextBlock x:Name="StatusText"
                   MaxWidth="720"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>
</Window>
