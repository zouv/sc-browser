<Window x:Class="ScBrowser.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 ScBrowser"
        Width="520" Height="296"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="/Assets/sc-browser.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <!-- 无边框自绘，与外壳同一套观感；内容简单，所以不用 WindowChrome（不需要缩放/贴靠） -->
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black" />
        </Border.Effect>

        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image x:Name="AppIcon" Width="52" Height="52" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ScBrowser" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="基于 WPF + Microsoft Edge WebView2 的 Windows 桌面浏览器，支持 Chrome 扩展。"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock Margin="0,14,0,4"
                           Text="用户数据目录"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="DataFolderText"
                         IsReadOnly="True"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="12"
                         Background="{DynamicResource AddressBarBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource SeparatorBrush}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OpenDataFolderButton"
                        Content="打开数据目录"
                        Padding="12,6"
                        Click="OpenDataFolder_Click" />
                <Button Content="关闭"
                        Padding="16,6"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
