<Window x:Class="ScBrowser.Views.FindBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Width="418"
        Height="46"
        Background="{DynamicResource ToolbarBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- 页内查找条：独立顶层窗口（不是 Popup）——Popup 拿不到键盘焦点，打字会落到网页上；
         普通 Window 才可靠地接收输入。无 AllowsTransparency 也是为了保住焦点。 -->
    <Border BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="1"
            Padding="10,6"
            MinWidth="380">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 不画放大镜图标（Chrome 的查找条同样没有）：图标只会挤占输入框空间。 -->
            <TextBox x:Name="FindBox"
                     Grid.Column="0"
                     Width="220"
                     Style="{StaticResource AddressBarTextBoxStyle}"
                     FontFamily="Segoe UI"
                     TextChanged="FindBox_TextChanged"
                     KeyDown="FindBox_KeyDown" />

            <TextBlock x:Name="FindStatus"
                       Grid.Column="1"
                       MinWidth="64"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <Button Grid.Column="3"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="&#xE70E;"
                    ToolTip="上一个匹配 (Shift+Enter)"
                    Click="FindPrevious_Click" />

            <Button Grid.Column="4"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="&#xE70D;"
                    ToolTip="下一个匹配 (Enter)"
                    Click="FindNext_Click" />

            <Button Grid.Column="5"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Content="&#xE711;"
                    ToolTip="关闭查找 (Esc)"
                    Click="FindClose_Click" />
        </Grid>
    </Border>
</Window>
