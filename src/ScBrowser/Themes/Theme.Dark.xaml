<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================== -->
    <!-- 深色主题 · 颜色令牌                                                     -->
    <!-- 键名与 Themes/Theme.Light.xaml 必须一一对应，否则运行时换肤会缺键。     -->
    <!-- ===================================================================== -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202124" />
    <SolidColorBrush x:Key="TabStripBackgroundBrush" Color="#202124" />
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#35363A" />
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#00000000" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="#3C4043" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#35363A" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#3C4043" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="AddressBarBackgroundBrush" Color="#202124" />
    <SolidColorBrush x:Key="AddressBarBorderBrush" Color="#00000000" />
    <SolidColorBrush x:Key="AddressBarFocusBorderBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8AB4F8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#AECBFA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#669DF6" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#202124" />
    <SolidColorBrush x:Key="IconBrush" Color="#9AA0A6" />
    <SolidColorBrush x:Key="IconDisabledBrush" Color="#5F6368" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F28B82" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#81C995" />

</ResourceDictionary>
